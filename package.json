{
  "name": "client",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^13.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^6.30.6",
    "react-scripts": "5.0.1",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "lint": "eslint src --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "rules": {
      "func-style": [
        "error",
        "expression"
      ],
      "prefer-arrow-callback": "error",
      "curly": [
        "error",
        "all"
      ],
      "padding-line-between-statements": [
        "error",
        {
          "blankLine": "always",
          "prev": "import",
          "next": "*"
        },
        {
          "blankLine": "any",
          "prev": "import",
          "next": "import"
        },
        {
          "blankLine": "always",
          "prev": "*",
          "next": [
            "return",
            "if",
            "for",
            "try"
          ]
        },
        {
          "blankLine": "always",
          "prev": [
            "if",
            "for",
            "try"
          ],
          "next": "*"
        },
        {
          "blankLine": "always",
          "prev": [
            "const",
            "let"
          ],
          "next": "expression"
        },
        {
          "blankLine": "always",
          "prev": "expression",
          "next": [
            "const",
            "let"
          ]
        },
        {
          "blankLine": "always",
          "prev": "block-like",
          "next": "*"
        }
      ],
      "no-restricted-syntax": [
        "error",
        {
          "selector": "FunctionExpression",
          "message": "Use an arrow function instead."
        }
      ],
      "no-restricted-imports": [
        "error",
        {
          "patterns": [
            {
              "group": [
                "./**",
                "../**"
              ],
              "message": "Use a src-root import, such as components/profile/AcademicProfile."
            }
          ]
        }
      ],
      "import/order": [
        "error",
        {
          "groups": [
            "builtin",
            "external",
            "internal",
            [
              "parent",
              "sibling",
              "index"
            ]
          ],
          "newlines-between": "always",
          "alphabetize": {
            "order": "asc",
            "caseInsensitive": true
          }
        }
      ],
      "import/first": "error",
      "import/no-duplicates": "error",
      "import/newline-after-import": [
        "error",
        {
          "count": 1
        }
      ]
    },
    "settings": {
      "import/internal-regex": "^(App|assets|components|constants|data|hooks|styles|utils|tests)(/|$)",
      "import/resolver": {
        "node": {
          "paths": [
            "src"
          ],
          "extensions": [
            ".js",
            ".jsx",
            ".json"
          ]
        }
      }
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "homepage": "https://www.rizagokhanbaykal.com",
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
